<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- name="root" mencakup SEMUA subfolder di bawah getExternalFilesDir(null) sekaligus
         (exports/, backups/, dan folder baru apa pun di masa depan) supaya bug FileProvider
         "Failed to find configured root" tidak muncul lagi kalau ada folder baru ditambahkan. -->
    <external-files-path name="root" path="." />
    <cache-path name="cache" path="." />
</paths>
